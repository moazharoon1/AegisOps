# AegisOps local configuration.
# Copy to `.env` (git-ignored) and fill in what you need:  cp .env.example .env
# Nothing in this file is required for the offline demo: without an OpenAI key the
# agents run in `deterministic` mode, which the dashboard labels clearly.

# --- AI (optional) -----------------------------------------------------------
# Your OpenAI API key enables live investigations. Never commit it.
OPENAI_API_KEY=
# auto = live when OPENAI_API_KEY is set, otherwise deterministic.
# live | replay | record | deterministic
AEGIS_LLM_MODE=auto
AEGIS_MODEL_SPECIALIST=gpt-5.4-mini-2026-03-17
AEGIS_MODEL_ANALYST=gpt-5.4-2026-03-05
AEGIS_EMBEDDING_MODEL=text-embedding-3-small
# Spending guards: new model calls stop once a limit is reached.
AEGIS_BUDGET_PER_INCIDENT_USD=1.00
AEGIS_BUDGET_PER_DAY_USD=10.00

# --- AWS emulator ------------------------------------------------------------
# Default: LocalStack 4.14.0 community edition (the last open-source release of
# github.com/localstack/localstack, pinned by digest). No account or token needed.
# Optional: set a token to run the current unified LocalStack image instead.
LOCALSTACK_AUTH_TOKEN=

# --- Local ports ---------------------------------------------------------------
AEGIS_DASHBOARD_PORT=8080
AEGIS_GRAFANA_PORT=3000

# --- Workflow defaults ---------------------------------------------------------
# Recovery verification window. The plan's default is 600s; shorter windows are
# reported as "shortened" in results.
AEGIS_VERIFICATION_WINDOW_SECONDS=600
AEGIS_APPROVAL_TTL_SECONDS=900
AEGIS_COMPACTION_THRESHOLD_TOKENS=12000
AEGIS_COMPACTION_TARGET_TOKENS=6000
